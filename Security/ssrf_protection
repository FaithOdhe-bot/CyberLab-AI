import socket
import ipaddress
import requests
from urllib.parse import urlparse

class SSRFProtectionError(Exception):
    pass

class SSRFValidator:
    ALLOWED_SCHEMES = {'http', 'https'}
    MAX_CONTENT_SIZE = 50 * 1024  # 50KB

    @staticmethod
    def is_ip_blocked(ip_str: str) -> bool:
        try:
            ip = ipaddress.ip_address(ip_str)
            # Block RFC 1918 (Private), Loopback, Link-Local (Cloud Metadata)
            if ip.is_private or ip.is_loopback or ip.is_link_local:
                return True
            # Explicit check for AWS metadata IP
            if ip_str == '169.254.169.254':
                return True
            return False
        except ValueError:
            return True

    @staticmethod
    def resolve_and_validate(url: str) -> str:
        parsed_url = urlparse(url)
        
        if parsed_url.scheme not in SSRFValidator.ALLOWED_SCHEMES:
            raise SSRFProtectionError(f"Invalid protocol scheme: {parsed_url.scheme}")
            
        hostname = parsed_url.hostname
        if not hostname:
            raise SSRFProtectionError("Invalid URL format.")

        try:
            # Resolve hostname to IP
            ip_address = socket.gethostbyname(hostname)
        except socket.gaierror:
            raise SSRFProtectionError(f"Could not resolve hostname: {hostname}")

        if SSRFValidator.is_ip_blocked(ip_address):
            raise SSRFProtectionError(f"Blocked IP address resolved: {ip_address}")

        return ip_address

    @staticmethod
    def safe_fetch(url: str) -> str:
        # Validate before fetch
        SSRFValidator.resolve_and_validate(url)

        try:
            # Enforce max content size during streaming
            response = requests.get(url, stream=True, timeout=5)
            content = b""
            for chunk in response.iter_content(chunk_size=1024):
                content += chunk
                if len(content) > SSRFValidator.MAX_CONTENT_SIZE:
                    raise SSRFProtectionError("Response content exceeds maximum allowed size (50KB).")
            return content.decode('utf-8')
        except requests.RequestException as e:
            raise SSRFProtectionError(f"Request failed: {str(e)}")

# --- Unit Tests / Examples ---
if __name__ == "__main__":
    def test_ssrf(url):
        print(f"Testing {url} ...")
        try:
            SSRFValidator.resolve_and_validate(url)
            print("  [PASS] URL validation succeeded.")
        except SSRFProtectionError as e:
            print(f"  [BLOCKED] {e}")

    test_ssrf("http://169.254.169.254/latest/meta-data/")
    test_ssrf("http://127.0.0.1/admin")
    test_ssrf("https://www.google.com")
    test_ssrf("ftp://example.com/file")
    test_ssrf("http://192.168.1.1/router")
